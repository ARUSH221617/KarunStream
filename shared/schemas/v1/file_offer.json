{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karunstream.local/schemas/v1/file_offer.json",
  "title": "KarunStream File Offer v1",
  "type": "object",
  "required": [
    "transfer_id",
    "sender_id",
    "file_name",
    "file_size",
    "sha256"
  ],
  "properties": {
    "transfer_id": {
      "type": "string",
      "minLength": 1
    },
    "sender_id": {
      "type": "string",
      "minLength": 1
    },
    "receiver_id": {
      "type": ["string", "null"]
    },
    "file_name": {
      "type": "string",
      "minLength": 1
    },
    "file_size": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "chunk_size": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "download_url": {
      "type": ["string", "null"]
    },
    "timestamp": {
      "type": "number"
    }
  },
  "additionalProperties": false
}
