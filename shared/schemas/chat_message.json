{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://karunstream.local/schemas/chat_message.json",
  "title": "KarunStream Chat Message",
  "type": "object",
  "required": ["msg_id", "sender_id", "receiver_id", "body", "timestamp"],
  "properties": {
    "msg_id": { "type": "string", "minLength": 1 },
    "sender_id": { "type": "string", "minLength": 1 },
    "receiver_id": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "message_type": { "type": "string", "enum": ["text", "system", "link"], "default": "text" },
    "timestamp": { "type": "number" }
  },
  "additionalProperties": false
}
